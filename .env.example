# Copy to .env and edit. Never commit .env.

# Database. The password must match POSTGRES_PASSWORD below.
# Inside Docker the host is "db". For `npm run dev` outside Docker use localhost:5432.
DATABASE_URL=postgresql://queuecare:change-me@db:5432/queuecare
POSTGRES_PASSWORD=change-me

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-bytes

# Used in QR codes and links. Use the server's LAN address.
APP_URL=http://192.168.1.10:3000

# Lets TV screens open the board without a login. Any random string.
DISPLAY_KEY=replace-with-random-string

# Days before patient name and phone are anonymised.
RETENTION_DAYS=90

# Encrypts nightly backups (used from Phase 5).
BACKUP_PASSPHRASE=replace-with-strong-passphrase

# none, msg91 or fast2sms (SMS is a later version).
SMS_PROVIDER=none
SMS_API_KEY=
