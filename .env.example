# Copy to .env and edit. Never commit .env.

# Database. The password must match POSTGRES_PASSWORD below.
# Inside Docker the host is "db". For `npm run dev` outside Docker use localhost:5432.
DATABASE_URL=postgresql://queuecare:change-me@db:5432/queuecare
POSTGRES_PASSWORD=change-me

# Session signing. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-random-32-bytes

# Used in QR codes and links. Use the server's LAN address.
APP_URL=http://192.168.1.10:3000

# Lets TV screens open the board without a login. Any random string.
DISPLAY_KEY=replace-with-random-string

# Days before patient name and phone are anonymised.
RETENTION_DAYS=90

# Encrypts the nightly backups. Keep a copy somewhere safe: without it a backup cannot be opened.
BACKUP_PASSPHRASE=replace-with-strong-passphrase
# Days of backups to keep in the ./backups folder, and the time zone of the 02:00 backup time.
BACKUP_KEEP_DAYS=14
BACKUP_TZ=Asia/Kolkata

# Only for the optional HTTPS service (docker compose --profile https up -d): the address people
# use, for example 192.168.1.10 or queue.myhospital.in
SITE_ADDRESS=localhost

# Set to 1 to switch off the nightly retention job that runs inside the app.
# DISABLE_JOBS=1

# none, msg91 or fast2sms (SMS is a later version).
SMS_PROVIDER=none
SMS_API_KEY=

# ---- Landing page (all optional) ----
# Address of this project on GitHub, shown in the footer and used in the install box.
#GITHUB_URL=https://github.com/your-org/queuecare
# A public demo you host. Until set, "Try the live demo" opens the login page of this server.
#DEMO_URL=
# Contact address shown in the footer.
#CONTACT_EMAIL=contact@example.org
